{
  "description": "Optimize pipeline baselines with balanced objectives using the pipeline training split.",
  "command": "optimize",
  "args": {
    "input": "evaluation/backgrounds",
    "backgrounds": "evaluation/backgrounds",
    "input-manifest": "output/pipeline/splits/train.json",
    "background-manifest": "output/pipeline/splits/train.json",
    "pattern-root": "output/pipeline/baseline",
    "output": "output/results_configured_optimized",
    "groups": "universal,forest,taiga,tundra,urban,desert,mountain,snow,jungle",
    "background-groups": "forest,desert,mountain,urban,jungle,snow,taiga,tundra",
    "candidates": 24,
    "beam-size": 8,
    "colors": 5,
    "segmentation": "semantic",
    "device": "auto",
    "objective-config": "configs/objective_balanced.json"
  }
}
